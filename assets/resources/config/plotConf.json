[
  {
    "id": "1",
    "txtid": "txt1",
    "txt": "救……救命……咳、咳咳……救……救命啊……"
  },
  {
    "id": "2",
    "txtid": "txt2",
    "txt": "有人吗？有人吗！咳咳……救救我！快救救我！咳……咳咳……"
  },
  {
    "id": "3",
    "txtid": "txt3",
    "txt": "你还在吗？你在哪？"
  },
  {
    "id": "4",
    "txtid": "txt4",
    "txt": "找到办法了吗？快救救我！"
  },
  {
    "id": "5",
    "txtid": "txt5",
    "txt": "火又变大了，要赶紧浇水。"
  },
  {
    "id": "6",
    "txtid": "txt6",
    "txt": "跟我来，我带你去找点吃的。"
  },
  {
    "id": "7",
    "txtid": "txt7",
    "txt": "这里有个红薯，把它烤了吃吧。"
  },
  {
    "id": "8",
    "txtid": "txt8",
    "txt": "还没熟透，再烤烤吧。"
  },
  {
    "id": "9",
    "txtid": "txt9",
    "txt": "都烤焦了怎么吃？再去拿个红薯过来吧。"
  },
  {
    "id": "10",
    "txtid": "txt10",
    "txt": "太重了，我一个人推不动。"
  },
  {
    "id": "11",
    "txtid": "txt11",
    "txt": "饿得没力气了，先去找点吃的吧。"
  },
  {
    "id": "12",
    "txtid": "txt12",
    "txt": "前面有个村子，先去找点吃的吧"
  },
  {
    "id": "13",
    "txtid": "txt13",
    "txt": "战争和饥荒逼得小二娃离开了家乡。"
  },
  {
    "id": "14",
    "txtid": "txt14",
    "txt": "他跟随红军撤离的方向，准备去投奔参加红军的哥哥。"
  },
  {
    "id": "15",
    "txtid": "txt15",
    "txt": "走了一天的小二娃饥渴难耐，体力即将耗尽。"
  },
  {
    "id": "16",
    "txtid": "txt16",
    "txt": "前面是个村庄，他准备去村里找点食物再休息一下。"
  },
  {
    "id": "17",
    "txtid": "txt17",
    "txt": "我们去偷偷看一眼，有问题赶紧跑。"
  },
  {
    "id": "18",
    "txtid": "txt18",
    "txt": "前面好像有个红军战士！"
  },
  {
    "id": "19",
    "txtid": "txt19",
    "txt": "哥？好像是我哥！"
  },
  {
    "id": "20",
    "txtid": "txt20",
    "txt": "有活的！抓活的！"
  },
  {
    "id": "21",
    "txtid": "txt21",
    "txt": "小兄弟，这里危险，大部队在西边，你们快走！"
  },
  {
    "id": "22",
    "txtid": "txt22",
    "txt": "小兄弟，这里危险，快往左边跑！"
  },
  {
    "id": "23",
    "txtid": "txt23",
    "txt": "后面有个红军战士，为了掩护我们一个人在挡着国民党！"
  },
  {
    "id": "24",
    "txtid": "txt24",
    "txt": "同志们，跟我冲！"
  },
  {
    "id": "25",
    "txtid": "txt25",
    "txt": "这附近不太安全，快跟我一起撤离吧。"
  },
  {
    "id": "26",
    "txtid": "txt26",
    "txt": "你答的不对，我不能给你开门。"
  },
  {
    "id": "27",
    "txtid": "txt27",
    "txt": "离开了被毁坏的村庄，小二娃继续寻找着红军的踪迹。"
  },
  {
    "id": "28",
    "txtid": "txt28",
    "txt": "然而，随着国民党围剿的不断逼近，"
  },
  {
    "id": "29",
    "txtid": "txt29",
    "txt": "原本平静安宁的野外，也变得危机四伏。"
  },
  {
    "id": "30",
    "txtid": "txt30",
    "txt": "答得不错，进来吧。"
  },
  {
    "id": "31",
    "txtid": "txt31",
    "txt": "红军部队现在都驻扎在附近，你可以看看你哥哥在不在。"
  },
  {
    "id": "32",
    "txtid": "txt32",
    "txt": "当兵就要当红军，处处工农来欢迎……"
  },
  {
    "id": "33",
    "txtid": "txt33",
    "txt": "慢点吃、慢点吃，吃饱了再去找哥哥。"
  },
  {
    "id": "34",
    "txtid": "txt34",
    "txt": "你们要快点回来啊！"
  },
  {
    "id": "35",
    "txtid": "txt35",
    "txt": "我这一把年纪还能不能去参加红军？"
  },
  {
    "id": "36",
    "txtid": "txt36",
    "txt": "二虎，我们俩分开找。"
  },
  {
    "id": "37",
    "txtid": "txt37",
    "txt": "嗯。"
  },
  {
    "id": "38",
    "txtid": "txt38",
    "txt": "嘿嘿，这下可以好好吃一顿了。"
  },
  {
    "id": "39",
    "txtid": "txt39",
    "txt": "等等，别给他换钱，他是小偷！"
  },
  {
    "id": "40",
    "txtid": "txt40",
    "txt": "你这记得也不对啊，是不是弄错了？"
  },
  {
    "id": "41",
    "txtid": "txt41",
    "txt": "没错，都对的上。"
  },
  {
    "id": "48",
    "txtid": "txt48",
    "txt": "小娃娃，谢谢你，这钱你拿着。"
  },
  {
    "id": "49",
    "txtid": "txt49",
    "txt": "部队明天就要撤离了，记得按时归队。"
  },
  {
    "id": "50",
    "txtid": "txt50",
    "txt": "二娃，我也出去转转。"
  },
  {
    "id": "51",
    "txtid": "txt51",
    "txt": "物资不够了，要去找政委再申请一些。"
  },
  {
    "id": "52",
    "txtid": "txt52",
    "txt": "同志，政委让我来申请点物资。"
  },
  {
    "id": "53",
    "txtid": "txt53",
    "txt": "政委让我过来帮你。"
  },
  {
    "id": "54",
    "txtid": "txt54",
    "txt": "工人同志们，红军送来的物资到了，大家可以回家了！"
  },
  {
    "id": "55",
    "txtid": "txt55",
    "txt": "太好了，我终于可以回家了！"
  },
  {
    "id": "56",
    "txtid": "txt56",
    "txt": "红军对我们这么好，我要去参加红军！"
  },
  {
    "id": "57",
    "txtid": "txt57",
    "txt": "谢谢赵医生，我的病有救了！"
  },
  {
    "id": "58",
    "txtid": "txt58",
    "txt": "我要加入红军！"
  },
  {
    "id": "59",
    "txtid": "txt59",
    "txt": "让我先加入！"
  },
  {
    "id": "60",
    "txtid": "txt60",
    "txt": "我也要加入红军！"
  },
  {
    "id": "61",
    "txtid": "txt61",
    "txt": "他还有呼吸，快去找点水来。"
  },
  {
    "id": "62",
    "txtid": "txt62",
    "txt": "这枚硬币您老人家可藏好了，千万千万别给那些反革命分子看到。"
  },
  {
    "id": "63",
    "txtid": "txt63",
    "txt": "思考再三，小二娃决定与二虎跟着红军一同撤离。"
  },
  {
    "id": "64",
    "txtid": "txt64",
    "txt": "越过一路围追堵截，大家感到十分疲惫。"
  },
  {
    "id": "65",
    "txtid": "txt65",
    "txt": "前方是宜章县白石渡镇，红军打算在这歇脚，整备扩红。"
  },
  {
    "id": "66",
    "txtid": "txt66",
    "txt": "1934年，中央苏区边境的小村庄"
  },
  {
    "id": "67",
    "txtid": "txt67",
    "txt": "1934年9月，被“围剿”的中央苏区"
  },
  {
    "id": "68",
    "txtid": "txt68",
    "txt": "1934年11月，宜章县白石渡镇"
  },
  {
    "id": "69",
    "txtid": "txt69",
    "txt": "二娃，你说过帮忙帮到底，我们去看看，不对劲就跑。"
  },
  {
    "id": "70",
    "txtid": "txt70",
    "txt": "我要赶紧回去告诉大妈。"
  },
  {
    "id": "71",
    "txtid": "txt71",
    "txt": ""
  }
]
